rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /sites/covermate/states/live {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sites/covermate/states/draft {
      allow read, write: if isAdmin();
    }

    match /sites/covermate/versions/{versionId} {
      allow read, write: if isAdmin();
    }

    match /contactLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
