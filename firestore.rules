rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.active == true
        && get(adminPath()).data.get('role', '') in ['owner', 'admin', 'administrator', 'advisor', 'adviser', 'ops', 'operations', 'readonly', 'read-only', 'read'];
    }

    function adminRole() {
      return get(adminPath()).data.role;
    }

    function isUatOnlyAdmin() {
      return isAdmin() && get(adminPath()).data.get('uatOnly', false) == true;
    }

    function canAccessSite(siteId) {
      return isAdmin() && (siteId == "covermate-uat" || !isUatOnlyAdmin());
    }

    function canReadOpsRecords(isUat) {
      return isAdmin() && (isUat || !isUatOnlyAdmin());
    }

    function canWriteOpsRecords(isUat) {
      return canReadOpsRecords(isUat)
        && adminRole() in ["owner", "admin", "administrator", "advisor", "adviser", "ops", "operations"];
    }

    function canEditContent(siteId) {
      return canAccessSite(siteId) && adminRole() in ['owner', 'admin', 'administrator'];
    }

    function validRevision() {
      return request.resource.data.revision is int
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
    }

    function validSiteId(siteId) {
      return siteId in ["covermate", "covermate-uat"];
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (isAdmin() && !isUatOnlyAdmin()));
      allow write: if false;
    }

    match /sites/{siteId}/states/live {
      allow read: if validSiteId(siteId);
      allow create: if validSiteId(siteId) && canEditContent(siteId) && request.resource.data.revision == 1;
      allow update: if validSiteId(siteId) && canEditContent(siteId) && validRevision();
    }

    match /sites/{siteId}/states/draft {
      allow read: if validSiteId(siteId) && canAccessSite(siteId);
      allow create: if validSiteId(siteId) && canEditContent(siteId) && request.resource.data.revision == 1;
      allow update: if validSiteId(siteId) && canEditContent(siteId) && validRevision();
    }

    match /sites/{siteId}/versions/{versionId} {
      allow read: if validSiteId(siteId) && canAccessSite(siteId);
      allow create: if validSiteId(siteId) && canEditContent(siteId);
    }

    match /contactLeads/{leadId} {
      allow create: if canWriteOpsRecords(false);
      allow read: if canReadOpsRecords(false);
      allow update: if canWriteOpsRecords(false);
      allow delete: if false;
    }

    match /contactLeadsUat/{leadId} {
      allow create: if canWriteOpsRecords(true);
      allow read: if canReadOpsRecords(true);
      allow update: if canWriteOpsRecords(true);
      allow delete: if false;
    }

    match /sites/{siteId}/analytics/{analyticsDoc} {
      allow read: if validSiteId(siteId) && canAccessSite(siteId);
      allow write: if validSiteId(siteId) && canEditContent(siteId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
