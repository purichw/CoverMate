rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.active == true;
    }

    function adminRole() {
      return get(adminPath()).data.role;
    }

    function isUatOnlyAdmin() {
      return isAdmin() && get(adminPath()).data.uatOnly == true;
    }

    function canAccessSite(siteId) {
      return isAdmin() && (siteId == "covermate-uat" || !isUatOnlyAdmin());
    }

    function canReadOpsRecords(isUat) {
      return isAdmin() && (isUat || !isUatOnlyAdmin());
    }

    function canWriteOpsRecords(isUat) {
      return canReadOpsRecords(isUat)
        && adminRole() in ["owner", "admin", "administrator", "advisor", "adviser", "ops", "operations"];
    }

    function validSiteId(siteId) {
      return siteId in ["covermate", "covermate-uat"];
    }

    function validLeadString(value, max) {
      return value is string && value.size() <= max;
    }

    function validLeadCreate() {
      return request.resource.data.keys().hasOnly([
          "name",
          "contact",
          "topic",
          "qtype",
          "coverage",
          "consent",
          "language",
          "summary",
          "sourcePath",
          "status",
          "read",
          "createdAt",
          "updatedAt"
        ])
        && validLeadString(request.resource.data.name, 120)
        && validLeadString(request.resource.data.contact, 160)
        && request.resource.data.contact.size() > 0
        && validLeadString(request.resource.data.topic, 2000)
        && validLeadString(request.resource.data.qtype, 40)
        && request.resource.data.qtype in ["", "quote", "compare", "general", "review", "claim"]
        && validLeadString(request.resource.data.coverage, 40)
        && request.resource.data.coverage in ["", "life", "health", "motor", "accident", "savings", "unsure"]
        && request.resource.data.consent == true
        && request.resource.data.language in ["th", "en"]
        && validLeadString(request.resource.data.summary, 1200)
        && validLeadString(request.resource.data.sourcePath, 220)
        && request.resource.data.status == "new"
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (isAdmin() && !isUatOnlyAdmin()));
      allow write: if false;
    }

    match /sites/{siteId}/states/live {
      allow read: if validSiteId(siteId);
      allow write: if validSiteId(siteId) && canAccessSite(siteId);
    }

    match /sites/{siteId}/states/draft {
      allow read, write: if validSiteId(siteId) && canAccessSite(siteId);
    }

    match /sites/{siteId}/versions/{versionId} {
      allow read, write: if validSiteId(siteId) && canAccessSite(siteId);
    }

    match /contactLeads/{leadId} {
      allow create: if validLeadCreate() || canWriteOpsRecords(false);
      allow read: if canReadOpsRecords(false);
      allow update: if canWriteOpsRecords(false);
      allow delete: if false;
    }

    match /contactLeadsUat/{leadId} {
      allow create: if validLeadCreate() || canWriteOpsRecords(true);
      allow read: if canReadOpsRecords(true);
      allow update: if canWriteOpsRecords(true);
      allow delete: if false;
    }

    match /sites/{siteId}/analytics/{analyticsDoc} {
      allow read, write: if validSiteId(siteId) && canAccessSite(siteId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
