{
  "version": "2.0",
  "description": "Proposed CoverMate defaults derived from the supplied visual direction. Reuse/map existing project tokens; these are not measured production values.",
  "color": {
    "canvas": "#F6EBDD",
    "surface": "#FCF8F2",
    "surfaceRaised": "#FFFFFF",
    "sidebar": "#2C281E",
    "sidebarText": "#E9E0D2",
    "text": "#29251F",
    "mutedText": "#736B5F",
    "border": "#DCCDB9",
    "primary": "#B74B12",
    "onPrimary": "#FFFFFF",
    "focus": "#925010"
  },
  "status": {
    "new": {
      "label": "New",
      "background": "#FDE6D3",
      "text": "#8E390F"
    },
    "in_progress": {
      "label": "In progress",
      "background": "#FAEBC5",
      "text": "#6B5212"
    },
    "contacted_reachable": {
      "label": "Contacted",
      "background": "#E5ECD9",
      "text": "#3E5A2A"
    },
    "contacted_no_answer": {
      "label": "No answer",
      "background": "#F4E2D8",
      "text": "#8D4527"
    },
    "closed_completed": {
      "label": "Closed · Completed",
      "background": "#E1ECD9",
      "text": "#36522A"
    },
    "closed_declined": {
      "label": "Closed · Not proceeding",
      "background": "#ECE8E2",
      "text": "#5A544E"
    }
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    20,
    24,
    32
  ],
  "radiusPx": {
    "card": 16,
    "input": 12,
    "pill": 999
  },
  "layoutPx": {
    "sidebar": 220,
    "desktopPadding": 32,
    "mobilePadding": 16,
    "detailDrawer": 440,
    "minimumDockedListWidth": 680,
    "minimumTouchTarget": 44
  },
  "breakpointsPx": {
    "tablet": 768,
    "desktop": 1200,
    "dockedDetail": 1600
  },
  "typography": {
    "fontFamily": "Reuse the existing CoverMate sans-serif stack and Thai fallback; do not ship fonts in this handoff.",
    "pageTitleDesktopPx": 32,
    "pageTitleMobilePx": 28,
    "bodyDesktopPx": 14,
    "bodyMobilePx": 16,
    "inputMobilePx": 16,
    "lineHeightBody": 1.5
  },
  "motion": {
    "drawerDurationMs": 180,
    "respectReducedMotion": true
  }
}
